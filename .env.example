# SlyTab configuration — copy to .env and fill in. NEVER commit .env.

# --- cPanel deploy (scripts/deploy-cpanel.mjs) ---
CPANEL_HOST=
CPANEL_PORT=2083
CPANEL_USER=
CPANEL_TOKEN=
# Remote path for the built SPA, e.g. /home/USER/public_html/slytab
WEB_ROOT=
# Remote path for the API front controller, e.g. /home/USER/public_html/slytab/api
API_WEB_ROOT=

# --- API runtime (api/) ---
# Local dev: the slytab-mysql container on kdocker2 (192.168.10.11:3306,
# db slytab_dev, user slytab) — see docs/dev-environment.md.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_ROOT_PASS=
# Receipt itemization: RECEIPT_ENGINE=auto prefers the local vision model
# (LOCAL_LLM_URL, ollama) and falls back to Claude only if a key is set.
RECEIPT_ENGINE=auto
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=qwen2.5vl:7b
# Credentials for the two doors in front of the house model host. Both are
# optional: a dev Ollama on the LAN or on this machine needs neither, and the
# request then goes out exactly as it always did.
#   LOCAL_LLM_TOKEN          the nginx front door's bearer token (#119)
#   LOCAL_LLM_CF_ACCESS_*    Cloudflare Access service token for the tunnel
#                            that publishes it (#124)
# docs/llm-requirements.md has both. Production gets its own copies from the
# PROD_* variables scripts/deploy-api.sh reads out of the real .env.
LOCAL_LLM_TOKEN=
LOCAL_LLM_CF_ACCESS_ID=
LOCAL_LLM_CF_ACCESS_SECRET=
ANTHROPIC_API_KEY=
SESSION_PEPPER=
INVITE_HMAC_KEY=
MIGRATE_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
