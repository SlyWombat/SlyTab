# Secrets — never commit
.env
.env.*
!.env.example
secrets/
apps/mobile/credentials.json
# Live session tokens for the documentation demo accounts (dev DB only, but
# they are still bearer tokens) — regenerated by scripts/docs/seed-demo.mjs.
scripts/docs/.seed.json
scripts/docs/.seed-tokens.json

# Dependencies
node_modules/
api/vendor/

# Build output
dist/
apps/web/dist/
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/

# Runtime data (server)
slytab-data/
*.sql.gz

# Tooling
.claude/
local-docs/
coverage/
playwright-report/
test-results/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# PHP tooling
api/.phpunit.result.cache

# Owner-only operational docs (steps Dave must take; excluded from the public repo)
docs/private/

# Real Splitwise exports dropped in the root for testing — other people's
# names and amounts; never belongs in the repo.
Splitwise expenses*.csv
Splitwise expenses*.xlsx

# Receipt fixtures are photos of real receipts (card tails, merchant tax
# ids) — the corpus is rebuilt from prod with
# scripts/dev/fetch-receipt-fixtures.sh, never committed. expected.json is.
api/tests/fixtures/receipts/*.jpg
api/tests/fixtures/receipts/*.jpeg
api/tests/fixtures/receipts/*.png

# Store bundles built for manual upload (build artifacts)
*.aab

# Generated store listing artwork
SlyTab-play-feature-*.png

# Generated store screenshots
store-screenshots/
SlyTab-play-icon-*.png

# Local release bookkeeping — machine state, not source
scripts/worker/.release-state.json
scripts/worker/.testflight-notified*
scripts/worker/release.log
scripts/worker/.slytab.apk
