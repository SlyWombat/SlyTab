{
  "expo": {
    "name": "SlyTab",
    "slug": "slytab",
    "scheme": "slytab",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0c1220",
    "ios": {
      "bundleIdentifier": "ca.electricrv.slytab",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "SlyTab uses the camera to scan receipts so expenses can be split by item.",
        "NSPhotoLibraryUsageDescription": "SlyTab lets you pick a receipt photo from your library to split an expense.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.slywombat.slytab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c1220"
      }
    },
    "splash": {
      "backgroundColor": "#0c1220",
      "resizeMode": "contain"
    },
    "notification": {
      "color": "#4f8ef7"
    },
    "extra": {
      "eas": {
        "projectId": "04e9b2b8-e6a9-4e27-8d8b-f8fc2694feff"
      }
    },
    "owner": "electricrv"
  }
}
