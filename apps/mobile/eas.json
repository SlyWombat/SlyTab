{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "ios-testflight": {
      "extends": "production",
      "credentialsSource": "local"
    },
    "production": {
      "autoIncrement": false
    },
    "android-apk": {
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "local"
    },
    "android-play": {
      "android": {
        "buildType": "app-bundle"
      },
      "credentialsSource": "local"
    },
    "ios-simulator": {
      "extends": "production",
      "ios": {
        "simulator": true
      },
      "env": {
        "SLYTAB_API_BASE": "http://127.0.0.1:8100/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6794502588",
        "ascApiKeyPath": "../../secrets/AuthKey_QUC9SR2G3F.p8",
        "ascApiKeyId": "QUC9SR2G3F"
      },
      "android": {
        "serviceAccountKeyPath": "../../secrets/play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
